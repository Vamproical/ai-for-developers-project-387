#!/bin/sh
# Maven Wrapper script

MAVEN_PROJECTBASEDIR="$(cd "$(dirname "$0")" && pwd)"
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ ! -f "$MAVEN_WRAPPER_PROPERTIES" ]; then
    echo "Error: maven-wrapper.properties not found"
    exit 1
fi

# Extract distribution URL
DISTRIBUTION_URL=$(grep "^distributionUrl=" "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2-)
WRAPPER_URL=$(grep "^wrapperUrl=" "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2-)

# Determine Maven home directory
MAVEN_HOME="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/dists/$(echo $DISTRIBUTION_URL | sed 's|.*/||' | sed 's|-bin.zip||')"

# Download wrapper JAR if needed
WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper..."
    curl -sL -o "$WRAPPER_JAR" "$WRAPPER_URL"
fi

# Check if Maven is already downloaded
if [ ! -d "$MAVEN_HOME" ]; then
    echo "Downloading Maven..."
    mkdir -p "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/dists"
    ZIP_FILE="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/dists/$(echo $DISTRIBUTION_URL | sed 's|.*/||')"
    curl -sL -o "$ZIP_FILE" "$DISTRIBUTION_URL"
    unzip -q "$ZIP_FILE" -d "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/dists"
    rm "$ZIP_FILE"
fi

# Run Maven
exec "$MAVEN_HOME/bin/mvn" "$@"
