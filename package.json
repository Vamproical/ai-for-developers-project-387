{
  "name": "ai-for-developers-project-387",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@typespec/compiler": "^1.14.0",
    "@typespec/http": "^1.14.0",
    "@typespec/openapi": "^1.14.0",
    "@typespec/openapi3": "^1.14.0",
    "@typespec/rest": "^0.84.0",
    "@typespec/versioning": "^0.84.0"
  },
  "packageManager": "npm@12.0.2+sha512.b885e890b9418fa1693544d05f53e64f9a73ec194837d4258b15fecdd692347b1dd2a517b1b0cbaf9d31cd8e92c3b70956bd2ecc72833a57b4b3098f5bfa7943",
  "scripts": {
    "prepare": "husky",
    "build": "npm run tsp:compile && cd frontend && npm run build",
    "dev": "concurrently -k -n backend,frontend -c yellow,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && ./mvnw spring-boot:run",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "cd backend && ./mvnw -q spring-boot:run",
    "test": "npm run tsp:validate && cd frontend && npm run test:run",
    "tsp:validate": "npx tsp compile main.tsp --no-emit",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint": "cd frontend && npm run lint",
    "tsp:compile": "npx tsp compile main.tsp",
    "tsp:watch": "npx tsp compile main.tsp --watch"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "concurrently": "^9.2.1",
    "dayjs": "^1.11.21",
    "husky": "^9.1.7"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
